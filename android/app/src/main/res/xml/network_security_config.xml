<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Producción: solo conexiones cifradas y ancladas a CAs del sistema o a la CA
         corporativa instalada por el usuario (RSA-4096 de Actas Digitales). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Excepciones admitidas únicamente para servidores de desarrollo en LAN / emulador.
         Cualquier otro dominio sigue exigiendo HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">actasdigitales.local</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
