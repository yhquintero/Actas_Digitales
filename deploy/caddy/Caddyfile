# Caddyfile para Actas Digitales con HTTPS automático o certificados personalizados
{
    email admin@actasdigitales.local
}

actasdigitales.local, localhost {
    # Certificado TLS local generado o Let's Encrypt en producción
    tls /certs/fullchain.pem /certs/server.key

    # Cabeceras de seguridad
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "microphone=(self)"
    }

    # API y Web reverse proxy
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy web:80
    }
}
